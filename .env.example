# ==============================================================================
# Enterprise Pipe/Tube Manufacturing ERP - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit sensitive credentials or actual secrets to version control.
# - Ensure all placeholders (<...>) are replaced with valid configuration values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM - Production PostgreSQL)
# ------------------------------------------------------------------------------
# Standard PostgreSQL Connection String:
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>&sslmode=<SSL_MODE>
#
# Standard / Deployment Default (AWS RDS, Render, Docker, Vercel, Supabase, Neon):
DATABASE_URL="postgresql://user:password@host:5432/tubex_db?schema=public&sslmode=prefer"

# Direct URL for Prisma migrations & DDL (Used when connection poolers like PgBouncer / Neon / Supabase are active):
# In pooled setups, DATABASE_URL connects to the pooler (port 6543) and DIRECT_URL connects directly (port 5432).
# If not using a pooler, DIRECT_URL should match DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/tubex_db?schema=public&sslmode=prefer"

# Production Example (AWS RDS / Aurora PostgreSQL with SSL enforcement):
# DATABASE_URL="postgresql://dbadmin:YourStrongPasswordHere@erp-postgres-cluster.c9xxxxxx.us-east-1.rds.amazonaws.com:5432/tubex_db?schema=public&sslmode=require"
# DIRECT_URL="postgresql://dbadmin:YourStrongPasswordHere@erp-postgres-cluster.c9xxxxxx.us-east-1.rds.amazonaws.com:5432/tubex_db?schema=public&sslmode=require"

# Supabase / Neon Connection Pooling Example:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Local Docker / Local PostgreSQL (Development):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tubex_db?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tubex_db?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & NETWORKING
# ------------------------------------------------------------------------------
# Environment mode ('development' | 'production' | 'test')
NODE_ENV="production"

# Port on which Next.js will listen
PORT=3000

# Canonical Public URL of the deployed application (used for redirects, CORS, and metadata)
# Example: https://erp.yourdomain.com or https://<app-id>.amplifyapp.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify HMAC session tokens and cookies.
# Generate a strong 64-character hex key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_a_secure_random_64_character_hex_key_for_production"

# Session Expiry in hours (Default: 8 hours)
SESSION_MAX_AGE_HOURS=8
