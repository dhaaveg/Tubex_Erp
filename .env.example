# ==============================================================================
# Enterprise Pipe/Tube Manufacturing ERP - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit sensitive credentials or actual secrets to version control.
# - Ensure all placeholders (<...>) are replaced with valid configuration values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for AWS RDS / Aurora or local PostgreSQL instance.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>&sslmode=<SSL_MODE>
#
# Production (AWS RDS PostgreSQL with SSL enforcement):
# DATABASE_URL="postgresql://dbadmin:YourStrongPasswordHere@erp-postgres-cluster.c9xxxxxx.us-east-1.rds.amazonaws.com:5432/pipe_erp?schema=public&sslmode=require"
#
# Local Docker or Local PostgreSQL (Development):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pipe_erp?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & NETWORKING
# ------------------------------------------------------------------------------
# Environment mode ('development' | 'production' | 'test')
NODE_ENV="production"

# Port on which Next.js will listen
PORT=3000

# Canonical Public URL of the deployed application (used for redirects, CORS, and metadata)
# Example: https://erp.yourdomain.com or https://<app-id>.amplifyapp.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify HMAC session tokens and cookies.
# Generate a strong 64-character hex key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_a_secure_random_64_character_hex_key_for_production"

# Session Expiry in hours (Default: 8 hours)
SESSION_MAX_AGE_HOURS=8
